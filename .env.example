# Origem do backend, sem /api. Copie este arquivo para .env.local.
API_PROXY_TARGET=localhost:8080/api/
# Use os valores de SPRING_SECURITY_USER_NAME e SPRING_SECURITY_USER_PASSWORD do backend.
# Não use prefixo VITE_ para credenciais. Senhas com # devem ficar entre aspas.
# Para um $ literal, use \$ (o carregador expande variáveis).
API_USERNAME=valor_de_SPRING_SECURITY_USER_NAME
API_PASSWORD=valor_de_SPRING_SECURITY_USER_PASSWORD

# Se omitido, o Radar utiliza o mesmo destino da API principal.
RADAR_API_PROXY_TARGET=https://backend-5lgu.onrender.com
RADAR_DATA_SOURCE=radar
# Credenciais específicas são opcionais; vazias utilizam as da API principal.
# RADAR_API_USERNAME=
# RADAR_API_PASSWORD=
